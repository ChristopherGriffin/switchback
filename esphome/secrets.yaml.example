# Copy this file to secrets.yaml in the same folder and fill in the values.
# secrets.yaml is ignored by git.
#
# Whatever is in secrets.yaml gets written to every plug, so
# tools/build_payload.py refuses to build while a value it needs is blank.

# Needed by both builds.
# The key is 32 random bytes in base64. One way to make one:
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
api_encryption_key: ""
ota_password: ""

# Needed by the implant build only: the network the plug joins by itself.
wifi_ssid: ""
wifi_password: ""
